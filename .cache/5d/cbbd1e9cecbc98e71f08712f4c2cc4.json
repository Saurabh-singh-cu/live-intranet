ontent: center;\n  align-items: center;\n}\n\n.login-form-wrapper {\n  max-width: 400px;\n  width: 100%;\n}\n\n.login-title {\n  font-size: 2rem;\n  font-weight: bold;\n  color: #333;\n  text-align: center;\n  /* margin-bottom: 2rem; */\n}\n\n.login-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.form-label {\n  font-size: 0.875rem;\n  /* margin-bottom: 0.5rem; */\n  color: #4a5568;\n}\n\n.form-input {\n  padding: 0.5rem;\n  border: 1px solid #e2e8f0;\n  border-radius: 0.25rem;\n  font-size: 1rem;\n}\n\n.form-input:focus {\n  outline: none;\n  border-color: #77747e;\n  box-shadow: 0 0 0 3px rgba(147, 112, 219, 0.1);\n}\n\n.recaptcha-container {\n  margin-top: 1rem;\n}\n\n.submit-button {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  background-color: #4e4c52;\n  color: white;\n  border: none;\n  border-radius: 0.25rem;\n  font-size: 1rem;\n  cursor: pointer;\n  transition: background-color 0.3s;\n}\n\n.submit-button:hover {\n  background-color: #8A2BE2;\n}\n\n.sign-in-link {\n  margin-top: 1rem;\n  text-align: center;\n  font-size: 0.875rem;\n  color: #4a5568;\n}\n\n.sign-in-anchor {\n  color: #9370DB;\n  text-decoration: none;\n}\n\n.sign-in-anchor:hover {\n  text-decoration: underline;\n}\n\n.login-image-container {\n  display: none;\n  width: 70%;\n  background-image: url('../assets/images/loginback.png');\n  background-size: cover;\n  background-position: center;\n}\n\n.login-image-overlay {\n  height: 100%;\n  width: 100%;\n  background-color: rgba(0, 0, 0, 0.5);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  color: white;\n  text-align: center;\n  padding: 2rem;\n}\n\n.image-title {\n  font-size: 2.5rem;\n  font-weight: bold;\n  margin-bottom: 1rem;\n}\n\n.image-subtitle {\n  font-size: 1.25rem;\n}\n\n@media (min-width: 1024px) {\n  .login-form-container {\n    width: 30%;\n  }\n\n  .login-image-container {\n    display: block;\n  }\n}\n\n.typewriter {\n\twidth: 600px;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\tborder-right: 4px solid #212121;\n\tanimation: cursor 1s step-start infinite, \n    text 5s steps(40) alternate infinite;\n}\n\n@keyframes cursor {\n\t0%, 100% { \n    border-color: #686464; \n \n  }\n}\n\n@keyframes text {\n\t0% { \n    width: 0; \n  }\n\t100% { \n    width: 470px; \n  }\n}\n/* ... (existing styles) ... */\n\n.forgot-password-link {\n  text-align: right;\n  /* margin-top: 1rem; */\n}\n\n.forgot-password-link a {\n  color: #4a90e2;\n  text-decoration: none;\n  font-size: 0.9rem;\n}\n\n.forgot-password-link a:hover {\n  text-decoration: underline;\n}\n\n/* Styles for the Ant Design Drawer */\n.ant-drawer-content-wrapper {\n  width: 400px !important;\n}\n\n.ant-drawer-header {\n  background-color: #f0f2f5;\n}\n\n.ant-drawer-title {\n  color: #333;\n  font-size: 1.2rem;\n}\n\n.forgot-password-form {\n  padding: 1rem;\n}\n\n.forgot-password-form p {\n  /* margin-bottom: 1rem; */\n  color: #555;\n}\n\n.forgot-password-form .form-group {\n  /* margin-bottom: 1rem; */\n}\n\n.forgot-password-form label {\n  display: block;\n  margin-bottom: 0.5rem;\n  color: #555;\n}\n\n.forgot-password-form .form-input {\n  width: 100%;\n  padding: 0.5rem;\n  border: 1px solid #d9d9d9;\n  border-radius: 4px;\n}\n\n.forgot-password-form .submit-button {\n  width: 100%;\n  padding: 0.75rem;\n  background-color: #4a90e2;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.forgot-password-form .submit-button:hover {\n  background-color: #357abd;\n}\n\n.forgot-password-form .submit-button:disabled {\n  background-color: #ccc;\n  cursor: not-allowed;\n}\n\n/* ... (rest of the existing styles) ... */\n\n"},"lineCount":null}},"error":null,"hash":"830138d3a7ae7cf215e446e643278c11","cacheData":{"env":{}}}