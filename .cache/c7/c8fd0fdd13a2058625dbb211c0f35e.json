-family: Arial, sans-serif;\r\n  }\r\n  \r\n  .customDrawer :global(.ant-drawer-header) {\r\n    background-color: #f0f2f5;\r\n    border-bottom: 1px solid #e8e8e8;\r\n  }\r\n  \r\n  .customDrawer :global(.ant-drawer-title) {\r\n    color: #333;\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  .customDrawer :global(.ant-drawer-body) {\r\n    padding: 24px;\r\n  }\r\n  \r\n  .drawerContent {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 16px;\r\n  }\r\n  \r\n  .detailItem {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n  }\r\n  \r\n  .detailLabel {\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n    color: #666;\r\n  }\r\n  \r\n  .detailValue {\r\n    font-size: 16px;\r\n    color: #333;\r\n  }\r\n\r\n  /* Add this to your existing CSS */\r\n.statusDropdown {\r\n    padding: 5px 10px;\r\n    border-radius: 4px;\r\n    border: 1px solid #ccc;\r\n    background-color: #fff;\r\n    font-size: 14px;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .statusDropdown:hover {\r\n    border-color: #888;\r\n  }\r\n  \r\n  .statusDropdown:focus {\r\n    outline: none;\r\n    border-color: #0066cc;\r\n    box-shadow: 0 0 0 2px rgba(0,102,204,0.2);\r\n  }\r\n  \r\n  /* You may want to remove or adjust these status-specific styles */\r\n  .status.pending { background-color: #ffd700; }\r\n  .status.approved { background-color: #90ee90; }\r\n  .status.rejected { background-color: #ff6347; }\r\n  .status.cancelled { background-color: #d3d3d3; }\r\n  \r\n  "},"lineCount":160}},"error":null,"hash":"eaeda46c20599ced61012100c45bde79","cacheData":{"env":{}}}