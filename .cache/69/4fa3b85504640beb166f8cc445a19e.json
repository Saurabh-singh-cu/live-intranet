nents/form/JoinNow.css","original":{"line":240,"column":0},"generated":{"line":240,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":241,"column":0},"generated":{"line":241,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":242,"column":0},"generated":{"line":242,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":243,"column":0},"generated":{"line":243,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":244,"column":0},"generated":{"line":244,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":245,"column":0},"generated":{"line":245,"column":0}},{"source":"src/components/form/JoinNow.css","original":{"line":246,"column":0},"generated":{"line":246,"column":0}}],"sources":{"src/components/form/JoinNow.css":".registration-container {\n  display: flex;\n  /* min-height: 100vh; */\n  background-color: #f5f5f5;\n  padding: 6rem;\n  height: 100vh;\n}\n\n.border-line {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  background-color: #ffffff;\n  border-radius: 20px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  overflow: hidden;\n}\n\n.sidebar-joinnow {\n  background-color: #4a4a4a;\n  color: white;\n  padding: 2rem;\n  overflow-y: auto;\n  max-height: 100vh;\n}\n\n.main-content {\n  flex: 1;\n  padding: 2rem;\n}\n\n.form-section {\n  margin-bottom: 2rem;\n}\n\n.form-section h3 {\n  color: #4a4a4a;\n  font-size: 1.2rem;\n  margin-bottom: 1rem;\n  padding: 0.5rem 0;\n  border-bottom: 2px solid #4a4a4a;\n}\n\n.input-grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.form-input,\n.form-select {\n  width: 100%;\n  padding: 0.75rem;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n  font-size: 1rem;\n}\n\n.error {\n  color: #ff0000;\n  font-size: 0.8rem;\n  margin-top: 0.25rem;\n}\n\n.verification-grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.email-group,\n.otp-group {\n  display: flex;\n  gap: 1rem;\n}\n\n.email-input-container {\n  flex: 1;\n  position: relative;\n}\n\n.domain {\n  position: absolute;\n  right: 1rem;\n  top: 50%;\n  transform: translateY(-50%);\n  color: #666;\n}\n\n.verified-badge {\n  position: absolute;\n  right: -1.5rem;\n  top: 50%;\n  transform: translateY(-50%);\n  color: #00c853;\n}\n\n.otp-button,\n.verify-button,\n.register-button-joinnow {\n  padding: 0.75rem 1.5rem;\n  background: #ff0000;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.otp-button:disabled,\n.verify-button:disabled,\n.register-button-joinnow:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.register-button-joinnow {\n  display: block;\n  width: 100%;\n  max-width: 300px;\n  margin: 2rem auto 0;\n}\n\n@media (min-width: 768px) {\n  .border-line {\n    flex-direction: row;\n  }\n\n  .sidebar-joinnow {\n    width: 30%;\n  }\n\n  .main-content {\n    width: 70%;\n  }\n\n  .input-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 767px) {\n  .registration-container {\n    padding: 1rem;\n    margin-top: 85px;\n  }\n  .subtitle{\n    margin-top: 20px;\n  }\n\n  .border-line {\n    border-radius: 10px;\n  }\n\n  .sidebar-joinnow {\n    padding: 1rem;\n  }\n\n  .main-content {\n    padding: 1rem;\n  }\n\n  .email-group,\n  .otp-group {\n    flex-direction: column;\n  }\n\n  .otp-button,\n  .verify-button {\n    width: 100%;\n  }\n  .requirements-list{\n    display: none;\n  }\n}\n\n/* Payment styles */\n.payment-container {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #f5f5f5;\n  padding: 1rem;\n}\n\n.payment-form-wrapper {\n  background-color: #ffffff;\n  padding: 2rem;\n  border-radius: 8px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  width: 100%;\n  max-width: 400px;\n}\n\n.payment-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.pay-button {\n  background-color: #4f46e5;\n  color: white;\n  border: none;\n  padding: 0.75rem;\n  border-radius: 4px;\n  font-size: 1rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.pay-button:hover {\n  background-color: #4338ca;\n}\n\n.secure-payment-info {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 1rem;\n  font-size: 0.75rem;\n  color: #6b7280;\n}\n\n.requirements-list {\n  /* list-style-type: none; */\n  /* padding-left: 1.5rem; */\n}\n\n.requirements-list li {\n  position: relative;\n  /* margin-bottom: 0.75rem; */\n  padding: 0.1rem .5rem .5rem 1rem;\n  /* background-color: rgba(255, 255, 255, 0.1); */\n  border-radius: 8px;\n  font-style: italic;\n  list-style: disc;\n}\n.subtitle{\n  margin-top: 20px;\n  margin-bottom: 20px;\n}\n\n"},"lineCount":246}},"error":null,"hash":"aac1ac6e494d9ba4dae5e26b5733fcc6","cacheData":{"env":{}}}