gle;\n      var innerPoint = polarToCartesian(cx, cy, innerRadius, angle);\n      var outerPoint = polarToCartesian(cx, cy, outerRadius, angle);\n      x1 = innerPoint.x;\n      y1 = innerPoint.y;\n      x2 = outerPoint.x;\n      y2 = outerPoint.y;\n    } else {\n      return getRadialCursorPoints(activeCoordinate);\n    }\n  }\n  return [{\n    x: x1,\n    y: y1\n  }, {\n    x: x2,\n    y: y2\n  }];\n}"},"lineCount":null}},"error":null,"hash":"40b562da446004414fbf56b90cdbe8bb","cacheData":{"env":{}}}