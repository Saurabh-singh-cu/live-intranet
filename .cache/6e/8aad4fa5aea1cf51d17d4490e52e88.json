Bar.css","original":{"line":244,"column":0},"generated":{"line":244,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":245,"column":0},"generated":{"line":245,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":246,"column":0},"generated":{"line":246,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":247,"column":0},"generated":{"line":247,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":248,"column":0},"generated":{"line":248,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":249,"column":0},"generated":{"line":249,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":250,"column":0},"generated":{"line":250,"column":0}},{"source":"src/pages/NavBar.css","original":{"line":251,"column":0},"generated":{"line":251,"column":0}}],"sources":{"src/pages/NavBar.css":".navbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 20px;\n  background-color: #ffffff;\n  border-bottom: 1px solid #e0e0e0;\n  position: fixed;\n  width: 100%;\n  box-sizing: border-box;\n  z-index: 999;\n}\n\n.navbar-left {\n  display: flex;\n  align-items: center;\n}\n\n.logoooo {\n  font-size: 24px;\n  font-weight: bold;\n}\n\n.logo-cu {\n  color: #ff0000;\n}\n\n.logo-ims {\n  color: #333;\n}\n\n.search-wrapper {\n  position: relative;\n  flex-grow: 1;\n  max-width: 600px;\n  margin: 0 40px;\n}\n\n.search-container {\n  width: 100%;\n}\n\n.search-input {\n  width: 100%;\n  padding: 10px 16px;\n  border: 1px solid #e0e0e0;\n  border-radius: 4px;\n  font-size: 14px;\n  background-color: #f5f5f5;\n  outline: none;\n  transition: border-color 0.2s;\n}\n\n.search-input:focus {\n  border-color: #ccc;\n  background-color: #ffffff;\n}\n\n.search-results {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  margin-top: 4px;\n  background-color: #ffffff;\n  border: 1px solid #e0e0e0;\n  border-radius: 4px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  max-height: 300px;\n  overflow-y: auto;\n  z-index: 1000;\n}\n\n.search-result-item {\n  padding: 10px 16px;\n  cursor: pointer;\n  font-size: 14px;\n  color: #333;\n  transition: background-color 0.2s;\n}\n\n.search-result-item:hover {\n  background-color: #f5f5f5;\n}\n\n.search-result-item.no-results {\n  color: #666;\n  cursor: default;\n}\n\n.navbar-right {\n  display: flex;\n  align-items: center;\n}\n\n.icon-button {\n  background: none;\n  border: none;\n  font-size: 20px;\n  color: #666;\n  cursor: pointer;\n  margin-left: 15px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.user-profile {\n  display: flex;\n  align-items: center;\n  margin-left: 15px;\n  justify-content: center;\n}\n\n.user-name {\n  font-size: 14px;\n  margin-right: 10px;\n  color: #ffffff;\n  background-color: black;\n  padding: 8px;\n  border-radius: 3px;\n}\n\n.logout1 {\n  justify-content: center;\n  align-items: center;\n  display: flex;\n  color: white;\n  font-weight: bold;\n}\n\n.userOnNav {\n  font-size: 14px;\n  color: black;\n  letter-spacing: 0.5px;\n  font-family: \"Roboto\", sans-serif !important;\n}\n\n.greenDot {\n  background-color: #86c915;\n  border-radius: 50%;\n  width: 6px;\n  height: 6px;\n  margin-right: 4px;\n}\n\n.btn-11 {\n  color: #fff;\n  background: linear-gradient(135deg, #ff9a00, #ff5f6d);\n  width: 100px;\n  height: 30px;\n  border: none;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.btn-11:hover {\n  filter: brightness(1.1);\n}\n.nav-button {\n  border: none;\n  background-color: white;\n  margin-right: 10px;\n  cursor: pointer;\n}\n\n.menu-button {\n  display: none;\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: #666;\n  cursor: pointer;\n}\n\n.mobile-menu {\n  display: none;\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  background-color: #ffffff;\n  border-top: 1px solid #e0e0e0;\n  padding: 10px;\n  flex-direction: column;\n}\n\n.mobile-menu .icon-button {\n  margin: 10px 0;\n  width: 100%;\n  justify-content: flex-start;\n}\n.menu-show- {\n  font-size: 12px;\n}\n\n.mobile-menu .icon-button span:last-child {\n  margin-left: 10px;\n}\n\n@media (max-width: 768px) {\n  .desktop-only {\n    display: none;\n  }\n\n  .mobile-only {\n    display: block;\n  }\n\n  .navbar-right {\n    justify-content: flex-end;\n  }\n\n  .menu-button {\n    display: block;\n    margin-left: 15px;\n  }\n\n  .mobile-menu {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 15px;\n  }\n\n  .search-wrapper {\n    display: none;\n  }\n}\n\n@media (min-width: 769px) {\n  .mobile-only {\n    display: none;\n  }\n}\n\n/* Dropdown Menu */\n.ant-dropdown-menu {\n  list-style-type: none;\n  background-color: #ffffff;\n  background-clip: padding-box;\n  border-radius: 8px;\n  outline: none;\n  box-shadow: 0 6px 16px 0 rgba(0, 0, 0, 0.08),\n    0 3px 6px -4px rgba(0, 0, 0, 0.12), 0 9px 28px 8px rgba(0, 0, 0, 0.05);\n  margin-top: -13px !important;\n}\n"},"lineCount":251}},"error":null,"hash":"154feba5fdeb578b7a0b3279eee48afc","cacheData":{"env":{}}}