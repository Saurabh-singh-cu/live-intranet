\r\n  position: absolute;\r\n  bottom: -10px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 80px;\r\n  height: 4px;\r\n  background: linear-gradient(90deg, #4a5568, #718096);\r\n  border-radius: 2px;\r\n}\r\n\r\n.committeeSubheading {\r\n  font-size: 1.1rem;\r\n  color: #718096;\r\n  margin-top: 1.5rem;\r\n}\r\n\r\n.departmentSection {\r\n  margin-bottom: 4rem;\r\n  background-color: white;\r\n  border-radius: 16px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);\r\n  padding: 2rem;\r\n  overflow: hidden;\r\n}\r\n\r\n.departmentHeading {\r\n  font-size: 1.5rem;\r\n  font-weight: 600;\r\n  color: #2d3748;\r\n  text-align: center;\r\n  margin-bottom: 2rem;\r\n  position: relative;\r\n  padding-bottom: 1rem;\r\n}\r\n\r\n.departmentHeading::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 60px;\r\n  height: 3px;\r\n  background: #718096;\r\n  border-radius: 2px;\r\n}\r\n\r\n.cardsContainer {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 2rem;\r\n}\r\n\r\n.committeeCard {\r\n  position: relative;\r\n  height: 100%;\r\n}\r\n\r\n.cardInner {\r\n  background-color: white;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);\r\n  height: 100%;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.committeeCard:hover .cardInner {\r\n  transform: translateY(-8px);\r\n  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.cardTop {\r\n  position: relative;\r\n  height: 160px;\r\n  background: linear-gradient(135deg, #f5f7fa 0%, #e4e7eb 100%);\r\n  display: flex;\r\n  justify-content: center;\r\n  padding-top: 1.5rem;\r\n}\r\n\r\n.profileImageContainer {\r\n  width: 120px;\r\n  height: 120px;\r\n  border-radius: 50%;\r\n  border: 4px solid white;\r\n  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\r\n  overflow: hidden;\r\n  z-index: 1;\r\n  background-color: white;\r\n  position: relative;\r\n}\r\n\r\n.profileImage {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  transition: transform 0.5s ease;\r\n}\r\n\r\n.committeeCard:hover .profileImage {\r\n  transform: scale(1.08);\r\n}\r\n\r\n.roleBadge {\r\n  position: absolute;\r\n  bottom: -15px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  padding: 0.5rem 1.5rem;\r\n  border-radius: 30px;\r\n  font-size: 0.9rem;\r\n  font-weight: 600;\r\n  color: white;\r\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\r\n  z-index: 2;\r\n  white-space: nowrap;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.badgeBlue {\r\n  background: linear-gradient(90deg, #3182ce, #4299e1);\r\n}\r\n\r\n.badgePurple {\r\n  background: linear-gradient(90deg, #805ad5, #9f7aea);\r\n}\r\n\r\n.badgeGreen {\r\n  background: linear-gradient(90deg, #38a169, #48bb78);\r\n}\r\n\r\n.badgeOrange {\r\n  background: linear-gradient(90deg, #dd6b20, #ed8936);\r\n}\r\n\r\n.badgeGray {\r\n  background: linear-gradient(90deg, #4a5568, #718096);\r\n}\r\n\r\n.cardContent {\r\n  padding: 2rem 1.5rem 1.5rem;\r\n  text-align: center;\r\n}\r\n\r\n.memberName {\r\n  font-size: 1.25rem;\r\n  font-weight: 700;\r\n  color: #2d3748;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.memberDepartment {\r\n  font-size: 0.95rem;\r\n  color: #4a5568;\r\n  font-weight: 500;\r\n  margin-bottom: 0.25rem;\r\n}\r\n\r\n.registrationName {\r\n  font-size: 0.85rem;\r\n  color: #718096;\r\n  font-style: italic;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.emailLink {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #4a5568;\r\n  text-decoration: none;\r\n  padding: 0.5rem;\r\n  border-radius: 8px;\r\n  background-color: #f7fafc;\r\n  transition: all 0.3s ease;\r\n  margin-top: 1rem;\r\n  border: 1px solid #e2e8f0;\r\n}\r\n\r\n.emailLink:hover {\r\n  background-color: #ebf4ff;\r\n  color: #3182ce;\r\n  border-color: #bee3f8;\r\n}\r\n\r\n.emailIcon {\r\n  font-size: 1.1rem;\r\n  margin-right: 0.5rem;\r\n}\r\n\r\n.emailText {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-size: 0.85rem;\r\n}\r\n\r\n.loadingContainer {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 4rem 2rem;\r\n  text-align: center;\r\n}\r\n\r\n.loadingSpinner {\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 3px solid rgba(113, 128, 150, 0.2);\r\n  border-radius: 50%;\r\n  border-top-color: #4a5568;\r\n  animation: spin 1s ease-in-out infinite;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n@keyframes spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n.errorContainer {\r\n  background-color: #fff5f5;\r\n  color: #e53e3e;\r\n  padding: 1.5rem;\r\n  border-radius: 8px;\r\n  border-left: 4px solid #e53e3e;\r\n  margin: 2rem auto;\r\n  max-width: 600px;\r\n  text-align: center;\r\n}\r\n\r\n/* Responsive adjustments */\r\n@media (max-width: 1200px) {\r\n  .cardsContainer {\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 1.5rem;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .committeeHeading {\r\n    font-size: 2rem;\r\n  }\r\n\r\n  .departmentHeading {\r\n    font-size: 1.25rem;\r\n  }\r\n\r\n  .departmentSection {\r\n    padding: 1.5rem;\r\n  }\r\n}\r\n\r\n@media (max-width: 576px) {\r\n  .cardsContainer {\r\n    grid-template-columns: 1fr;\r\n    max-width: 320px;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .pageWrapper {\r\n    padding: 1rem 0.5rem;\r\n  }\r\n\r\n  .committeeHeading {\r\n    font-size: 1.75rem;\r\n  }\r\n\r\n  .committeeSubheading {\r\n    font-size: 1rem;\r\n  }\r\n}\r\n\r\n"},"lineCount":304}},"error":null,"hash":"1949925234c3aa52b4b23d28a804dcee","cacheData":{"env":{}}}